{
  "buildCommand": "npx tsx scripts/postgres/upgrade-onboarding.ts --environment && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/designspace.ts": {
      "includeFiles": "api/_lib/*.html"
    }
  },
  "rewrites": [
    {
      "source": "/designspace",
      "destination": "/api/designspace"
    },
    {
      "source": "/designspace/",
      "destination": "/api/designspace"
    },
    {
      "source": "/ingest/static/:path(.*)",
      "destination": "https://us-assets.i.posthog.com/static/:path"
    },
    {
      "source": "/ingest/:path(.*)",
      "destination": "https://us.i.posthog.com/:path"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth"
    },
    {
      "source": "/api/session/:path*",
      "destination": "/api/session"
    },
    {
      "source": "/api/user/:path*",
      "destination": "/api/user"
    },
    {
      "source": "/api/feedback",
      "destination": "/api/feedback"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/share/:id",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "iad1"
  ],
  "installCommand": "npm ci",
  "headers": [
    {
      "source": "/share/:id",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/designspace-scorecards.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
