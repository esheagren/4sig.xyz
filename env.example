# Server only. Copy this file to .env for local development.
# Obtain DATABASE_URL from your Vercel project's Neon integration.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Optional analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=/ingest
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
